{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch App",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://localhost:8443",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "vite: dev",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    }
  ]
}
